menu "LCD1602 Clock Configuration"

    menu "WiFi Settings"
        config WIFI_SSID
            string "WiFi SSID"
            default "haoge"
            help
                WiFi 网络名称（SSID）

        config WIFI_PASSWORD
            string "WiFi Password"
            default "19901118"
            help
                WiFi 密码
    endmenu

    menu "LCD1602 Pin Configuration (8-bit Parallel)"
        comment "数据总线 D0~D7（8位并行）"

        config LCD_PIN_D0
            int "LCD D0 GPIO"
            default 12
            help
                LCD1602 数据总线 D0 引脚

        config LCD_PIN_D1
            int "LCD D1 GPIO"
            default 13
            help
                LCD1602 数据总线 D1 引脚

        config LCD_PIN_D2
            int "LCD D2 GPIO"
            default 14
            help
                LCD1602 数据总线 D2 引脚

        config LCD_PIN_D3
            int "LCD D3 GPIO"
            default 15
            help
                LCD1602 数据总线 D3 引脚

        config LCD_PIN_D4
            int "LCD D4 GPIO"
            default 16
            help
                LCD1602 数据总线 D4 引脚

        config LCD_PIN_D5
            int "LCD D5 GPIO"
            default 17
            help
                LCD1602 数据总线 D5 引脚

        config LCD_PIN_D6
            int "LCD D6 GPIO"
            default 18
            help
                LCD1602 数据总线 D6 引脚

        config LCD_PIN_D7
            int "LCD D7 GPIO"
            default 19
            help
                LCD1602 数据总线 D7 引脚

        comment "控制信号"

        config LCD_PIN_RS
            int "LCD RS GPIO"
            default 21
            help
                LCD1602 寄存器选择引脚（0=命令，1=数据）

        config LCD_PIN_E
            int "LCD E (Enable) GPIO"
            default 22
            help
                LCD1602 使能引脚（下降沿锁存数据）
                注意：RW 引脚请直接接 GND（始终写模式）

        config LCD_PIN_RST
            int "LCD RST GPIO"
            default 4
            help
                LCD1602 复位引脚（低电平有效）
    endmenu

    menu "Weather API Settings"
        config WEATHER_API_KEY
            string "QWeather API Key"
            default "04c81d5d4f3346a48d69b886c6c98cb0"
            help
                和风天气 API Key，在 https://dev.qweather.com 注册后获取。
                免费版每天 1000 次请求。

        config WEATHER_LOCATION_ID
            string "Location ID"
            default "101280601"
            help
                城市 Location ID，可在和风天气城市列表中查询。
                常用城市：
                  北京  101010100
                  上海  101020100
                  广州  101280101
                  深圳  101280601
                  杭州  101210101
                  成都  101270101

        config WEATHER_UPDATE_INTERVAL_MIN
            int "Weather update interval (minutes)"
            default 30
            range 5 1440
            help
                天气数据更新间隔（分钟），免费版建议 30 分钟以上。
    endmenu

    menu "NTP Settings"
        config NTP_SYNC_INTERVAL_MIN
            int "NTP re-sync interval (minutes)"
            default 60
            range 10 1440
            help
                NTP 时间重新同步间隔（分钟）。
    endmenu

    menu "Audio Announcement Settings"
        config AUDIO_I2S_BCLK_PIN
            int "Audio I2S BCLK GPIO"
            default 25
            help
                MAX98357A BCLK pin.

        config AUDIO_I2S_WS_PIN
            int "Audio I2S WS/LRCK GPIO"
            default 26
            help
                MAX98357A LRCK pin.

        config AUDIO_I2S_DOUT_PIN
            int "Audio I2S DOUT GPIO"
            default 27
            help
                MAX98357A DIN pin connected to ESP32 I2S data out.

        config AUDIO_ANNOUNCE_START_HOUR
            int "Hourly announce start hour"
            default 8
            range 0 23
            help
                Earliest hour for hourly voice announcement.

        config AUDIO_ANNOUNCE_END_HOUR
            int "Hourly announce end hour"
            default 20
            range 0 23
            help
                Latest hour for hourly voice announcement.
    endmenu

    menu "Indoor Sensor Settings"
        config DHT11_GPIO
            int "DHT11 data GPIO"
            default 23
            help
                DHT11 single-wire data pin. Use an external pull-up resistor.

        config DHT11_UPDATE_INTERVAL_SEC
            int "DHT11 update interval (seconds)"
            default 10
            range 2 3600
            help
                Interval between indoor temperature/humidity refreshes.
    endmenu

    menu "Display Settings"
        config DISPLAY_SCREEN_SWITCH_SEC
            int "Screen switch interval (seconds)"
            default 5
            range 2 60
            help
                Interval for alternating the two text screens.
    endmenu

endmenu