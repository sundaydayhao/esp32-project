# ============================================================
# ESP32-S3 desk clock SDK config
# ============================================================

CONFIG_IDF_TARGET="esp32s3"

# CPU 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Flash 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# HTTP Client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# ESP-TLS
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# mbedTLS
# Use software MPI for RSA certificate verification stability.
# CONFIG_MBEDTLS_HARDWARE_MPI is not set
# CONFIG_MBEDTLS_MPI_USE_INTERRUPT is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set

# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# NT35510 I80 hardware profile
CONFIG_DESK_CLOCK_NT35510_H_RES=800
CONFIG_DESK_CLOCK_NT35510_V_RES=480
CONFIG_DESK_CLOCK_NT35510_PIXEL_CLOCK_HZ=8000000
CONFIG_DESK_CLOCK_NT35510_DRAW_BUF_LINES=40
# CONFIG_DESK_CLOCK_NT35510_I80_BUS_WIDTH_8 is not set
CONFIG_DESK_CLOCK_NT35510_I80_BUS_WIDTH_16=y
CONFIG_DESK_CLOCK_NT35510_I80_BUS_WIDTH=16
CONFIG_DESK_CLOCK_NT35510_COLOR_ORDER_RGB=y
# CONFIG_DESK_CLOCK_NT35510_COLOR_ORDER_BGR is not set
CONFIG_DESK_CLOCK_NT35510_SWAP_XY=y
CONFIG_DESK_CLOCK_NT35510_MIRROR_X=y
# CONFIG_DESK_CLOCK_NT35510_MIRROR_Y is not set
# CONFIG_DESK_CLOCK_NT35510_INVERT_COLOR is not set
# CONFIG_DESK_CLOCK_NT35510_SWAP_RGB565_BYTES is not set
CONFIG_DESK_CLOCK_NT35510_BK_LIGHT_ACTIVE_HIGH=y
CONFIG_DESK_CLOCK_NT35510_POWER_ACTIVE_HIGH=y
CONFIG_DESK_CLOCK_NT35510_PIN_WR=18
CONFIG_DESK_CLOCK_NT35510_PIN_CS=17
CONFIG_DESK_CLOCK_NT35510_PIN_DC=16
CONFIG_DESK_CLOCK_NT35510_PIN_RST=20
CONFIG_DESK_CLOCK_NT35510_PIN_BK_LIGHT=38
CONFIG_DESK_CLOCK_NT35510_PIN_POWER=19
CONFIG_DESK_CLOCK_NT35510_PIN_D0=0
CONFIG_DESK_CLOCK_NT35510_PIN_D1=1
CONFIG_DESK_CLOCK_NT35510_PIN_D2=2
CONFIG_DESK_CLOCK_NT35510_PIN_D3=3
CONFIG_DESK_CLOCK_NT35510_PIN_D4=4
CONFIG_DESK_CLOCK_NT35510_PIN_D5=5
CONFIG_DESK_CLOCK_NT35510_PIN_D6=6
CONFIG_DESK_CLOCK_NT35510_PIN_D7=7
CONFIG_DESK_CLOCK_NT35510_PIN_D8=8
CONFIG_DESK_CLOCK_NT35510_PIN_D9=9
CONFIG_DESK_CLOCK_NT35510_PIN_D10=10
CONFIG_DESK_CLOCK_NT35510_PIN_D11=11
CONFIG_DESK_CLOCK_NT35510_PIN_D12=12
CONFIG_DESK_CLOCK_NT35510_PIN_D13=13
CONFIG_DESK_CLOCK_NT35510_PIN_D14=14
CONFIG_DESK_CLOCK_NT35510_PIN_D15=15

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Task watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# SPIFFS
CONFIG_SPIFFS_MAX_PARTITIONS=1

# Partition table
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_SIMSUN_16_CJK=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARC is not set
# CONFIG_LV_USE_BAR is not set
# CONFIG_LV_USE_BUTTON is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGE is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SLIDER is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_SWITCH is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_USE_GRID is not set
# CONFIG_LV_USE_OBSERVER is not set
