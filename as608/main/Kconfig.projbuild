menu "AS608 Fingerprint Example"

    menu "AS608 UART"

        config AS608_UART_NUM
            int "UART port number"
            default 1
            range 0 2
            help
                ESP-IDF UART port used to talk to the AS608 module.

        config AS608_UART_TX_GPIO
            int "ESP32 TX GPIO"
            default 17
            range -1 48
            help
                Connect this ESP32-S3 GPIO to AS608 RX.

        config AS608_UART_RX_GPIO
            int "ESP32 RX GPIO"
            default 18
            range -1 48
            help
                Connect this ESP32-S3 GPIO to AS608 TX.

        config AS608_BAUD_RATE
            int "UART baud rate"
            default 57600
            range 9600 115200
            help
                Most AS608/R30x-compatible modules default to 57600 baud.

        config AS608_UART_RX_BUFFER_SIZE
            int "UART RX buffer size"
            default 1024
            range 256 4096

        config AS608_COMMAND_TIMEOUT_MS
            int "Command response timeout (ms)"
            default 1200
            range 100 10000

        config AS608_POWER_ON_DELAY_MS
            int "Power-up delay before first command (ms)"
            default 500
            range 0 5000
            help
                Increase this if the sensor is powered from a rail that rises slowly.

    endmenu

    menu "AS608 Protocol"

        config AS608_DEVICE_ADDRESS
            hex "Device address"
            default 0xffffffff
            help
                Default AS608 device address is 0xffffffff.

        config AS608_PASSWORD
            hex "Device password"
            default 0x00000000
            help
                Default AS608 password is 0x00000000.

        config AS608_WAIT_TIMEOUT_MS
            int "Finger wait timeout (ms, 0 waits forever)"
            default 15000
            range 0 120000
            help
                Timeout used by the demo commands while waiting for a finger.

        config AS608_REMOVE_TIMEOUT_MS
            int "Finger removal timeout (ms, 0 waits forever)"
            default 10000
            range 0 120000
            help
                Timeout used by enrollment while waiting for the finger to be removed.

    endmenu

endmenu
