# Example defaults for the generic NT35510 I80 path.
# Update the display and SD pins to match the actual board before flashing.

# CONFIG_PHOTO_ALBUM_BOARD_WAVESHARE_7 is not set
CONFIG_PHOTO_ALBUM_BOARD_NT35510=y

CONFIG_PHOTO_ALBUM_NT35510_H_RES=800
CONFIG_PHOTO_ALBUM_NT35510_V_RES=480
CONFIG_PHOTO_ALBUM_NT35510_PIXEL_CLOCK_HZ=8000000
CONFIG_PHOTO_ALBUM_NT35510_DRAW_BUF_LINES=40

# CONFIG_PHOTO_ALBUM_NT35510_I80_BUS_WIDTH_8 is not set
CONFIG_PHOTO_ALBUM_NT35510_I80_BUS_WIDTH_16=y
CONFIG_PHOTO_ALBUM_NT35510_I80_BUS_WIDTH=16

CONFIG_PHOTO_ALBUM_NT35510_COLOR_ORDER_RGB=y
# CONFIG_PHOTO_ALBUM_NT35510_COLOR_ORDER_BGR is not set

CONFIG_PHOTO_ALBUM_NT35510_SWAP_XY=y
CONFIG_PHOTO_ALBUM_NT35510_MIRROR_X=y
# CONFIG_PHOTO_ALBUM_NT35510_MIRROR_Y is not set
# CONFIG_PHOTO_ALBUM_NT35510_INVERT_COLOR is not set
# CONFIG_PHOTO_ALBUM_NT35510_SWAP_RGB565_BYTES is not set
CONFIG_PHOTO_ALBUM_NT35510_BK_LIGHT_ACTIVE_HIGH=y
CONFIG_PHOTO_ALBUM_NT35510_POWER_ACTIVE_HIGH=y

CONFIG_PHOTO_ALBUM_NT35510_PIN_WR=18
CONFIG_PHOTO_ALBUM_NT35510_PIN_CS=17
CONFIG_PHOTO_ALBUM_NT35510_PIN_DC=16
CONFIG_PHOTO_ALBUM_NT35510_PIN_RST=20
CONFIG_PHOTO_ALBUM_NT35510_PIN_BK_LIGHT=38
CONFIG_PHOTO_ALBUM_NT35510_PIN_POWER=19

CONFIG_PHOTO_ALBUM_NT35510_PIN_D0=0
CONFIG_PHOTO_ALBUM_NT35510_PIN_D1=1
CONFIG_PHOTO_ALBUM_NT35510_PIN_D2=2
CONFIG_PHOTO_ALBUM_NT35510_PIN_D3=3
CONFIG_PHOTO_ALBUM_NT35510_PIN_D4=4
CONFIG_PHOTO_ALBUM_NT35510_PIN_D5=5
CONFIG_PHOTO_ALBUM_NT35510_PIN_D6=6
CONFIG_PHOTO_ALBUM_NT35510_PIN_D7=7
CONFIG_PHOTO_ALBUM_NT35510_PIN_D8=8
CONFIG_PHOTO_ALBUM_NT35510_PIN_D9=9
CONFIG_PHOTO_ALBUM_NT35510_PIN_D10=10
CONFIG_PHOTO_ALBUM_NT35510_PIN_D11=11
CONFIG_PHOTO_ALBUM_NT35510_PIN_D12=12
CONFIG_PHOTO_ALBUM_NT35510_PIN_D13=13
CONFIG_PHOTO_ALBUM_NT35510_PIN_D14=14
CONFIG_PHOTO_ALBUM_NT35510_PIN_D15=15

CONFIG_PHOTO_ALBUM_NT35510_SD_SPI_FREQ_KHZ=20000
CONFIG_PHOTO_ALBUM_NT35510_PIN_SD_MOSI=41
CONFIG_PHOTO_ALBUM_NT35510_PIN_SD_MISO=39
CONFIG_PHOTO_ALBUM_NT35510_PIN_SD_CLK=40
CONFIG_PHOTO_ALBUM_NT35510_PIN_SD_CS=42
