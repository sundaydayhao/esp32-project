menu "ESP32 Magnifier Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "MyWiFi"
        help
            SSID (network name) of the WiFi network to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "password123"
        help
            WiFi password (WPA/WPA2).

    config WIFI_MAXIMUM_RETRY
        int "Maximum WiFi retry count"
        default 5
        help
            Maximum number of retries when connecting to WiFi.

    choice CAMERA_MODEL
        prompt "Select Camera Board"
        default CAMERA_MODEL_AI_THINKER
        help
            Select the camera board/module being used.

        config CAMERA_MODEL_AI_THINKER
            bool "AI-Thinker ESP32-CAM"
        config CAMERA_MODEL_WROVER_KIT
            bool "ESP-WROVER-KIT"
        config CAMERA_MODEL_ESP_EYE
            bool "ESP-EYE"
        config CAMERA_MODEL_M5STACK_PSRAM
            bool "M5Stack Camera (PSRAM)"
        config CAMERA_MODEL_M5STACK_WIDE
            bool "M5Stack Camera Wide"
    endchoice

    config CAMERA_FRAME_SIZE
        int "Camera Frame Size (0=96x96 ... 13=UXGA 1600x1200)"
        default 6
        range 0 13
        help
            Camera resolution: 5=QVGA(320x240), 6=CIF(400x296),
            8=VGA(640x480), 9=SVGA(800x600), 10=XGA(1024x768),
            13=UXGA(1600x1200). Higher = better quality but slower.

    config CAMERA_JPEG_QUALITY
        int "JPEG Quality (0=best, 63=worst)"
        default 10
        range 0 63
        help
            JPEG compression quality. Lower value = better quality, larger file.

    config HTTP_SERVER_PORT
        int "HTTP Server Port"
        default 80
        help
            Port number for the web server.

endmenu