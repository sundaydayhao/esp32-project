# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# TTS 配置 (使用 edge-tts，无需 API Key)
# 可选声音: zh-CN-XiaoxiaoNeural, zh-CN-YunxiNeural, zh-CN-XiaoyiNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# 故事配置
STORY_MAX_TOKENS=800
STORY_LANGUAGE=zh-CN

# 日志级别
LOG_LEVEL=INFO