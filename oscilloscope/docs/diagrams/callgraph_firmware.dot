/**
 * ESP32-S3 Oscilloscope — Firmware Call Graph
 * Generated by static analysis (2026-03-19)
 *
 * Nodes: firmware functions
 * Edges: caller → callee
 * Color coding:
 *   lightblue  = public API (cross-module)
 *   lightyellow = static/internal functions
 *   lightgreen  = ESP-IDF / FreeRTOS API calls
 *   orange      = FreeRTOS tasks (entry points)
 */

digraph firmware_callgraph {
    rankdir = LR;
    node [shape=box, style=filled, fontname="Consolas", fontsize=10];
    edge [fontsize=9];

    /* ── Entry point ── */
    app_main [label="app_main()\nmain.c:16", fillcolor=lightcoral, style="filled,bold"];

    /* ── Public API nodes ── */
    adc_sampler_init    [label="adc_sampler_init()\nadc_sampler.c:140", fillcolor=lightblue];
    adc_sampler_get_frame [label="adc_sampler_get_frame()\nadc_sampler.c:193", fillcolor=lightblue];
    adc_sampler_set_rate  [label="adc_sampler_set_rate()\nadc_sampler.c:207", fillcolor=lightblue];
    adc_sampler_get_rate  [label="adc_sampler_get_rate()\nadc_sampler.c:214", fillcolor=lightblue];
    wifi_ap_init        [label="wifi_ap_init()\nwifi_ap.c:35", fillcolor=lightblue];
    http_server_start   [label="http_server_start()\nhttp_server.c:261", fillcolor=lightblue];
    http_server_stop    [label="http_server_stop()\nhttp_server.c:340", fillcolor=lightblue];

    /* ── Static/internal functions ── */
    adc_calibration_init [label="adc_calibration_init()\nadc_sampler.c:35", fillcolor=lightyellow];
    adc_sampler_task     [label="adc_sampler_task()\nadc_sampler.c:83\n[Task Core1 pri=5]", fillcolor=orange];
    wifi_event_handler   [label="wifi_event_handler()\nwifi_ap.c:21\n[Event CB]", fillcolor=lightyellow];
    pack_frame           [label="pack_frame()\nhttp_server.c:47", fillcolor=lightyellow];
    ws_broadcast_task    [label="ws_broadcast_task()\nhttp_server.c:76\n[Task Core0 pri=4]", fillcolor=orange];
    index_html_handler   [label="index_html_handler()\nhttp_server.c:118\n[HTTP CB]", fillcolor=lightyellow];
    app_js_handler       [label="app_js_handler()\nhttp_server.c:126\n[HTTP CB]", fillcolor=lightyellow];
    style_css_handler    [label="style_css_handler()\nhttp_server.c:133\n[HTTP CB]", fillcolor=lightyellow];
    api_info_handler     [label="api_info_handler()\nhttp_server.c:140\n[HTTP CB]", fillcolor=lightyellow];
    api_config_handler   [label="api_config_handler()\nhttp_server.c:158\n[HTTP CB]", fillcolor=lightyellow];
    ws_handler           [label="ws_handler()\nhttp_server.c:183\n[WS CB]", fillcolor=lightyellow];

    /* ── ESP-IDF / FreeRTOS API (abbreviated) ── */
    nvs_flash_init       [label="nvs_flash_init()\n[ESP-IDF]", fillcolor=lightgreen];
    xSemaphoreCreateMutex [label="xSemaphoreCreateMutex()\n[FreeRTOS]", fillcolor=lightgreen];
    xTaskCreatePinnedToCore [label="xTaskCreatePinnedToCore()\n[FreeRTOS]", fillcolor=lightgreen];
    xSemaphoreTake       [label="xSemaphoreTake()\n[FreeRTOS]", fillcolor=lightgreen];
    xSemaphoreGive       [label="xSemaphoreGive()\n[FreeRTOS]", fillcolor=lightgreen];
    adc_oneshot_read     [label="adc_oneshot_read()\n[esp_adc]", fillcolor=lightgreen];
    esp_timer_get_time   [label="esp_timer_get_time()\n[esp_timer]", fillcolor=lightgreen];
    esp_rom_delay_us     [label="esp_rom_delay_us()\n[esp_rom]", fillcolor=lightgreen];
    httpd_start          [label="httpd_start()\n[esp_http_server]", fillcolor=lightgreen];
    httpd_register_uri   [label="httpd_register_uri_handler()\n[esp_http_server]", fillcolor=lightgreen];
    httpd_ws_send_async  [label="httpd_ws_send_frame_async()\n[esp_http_server]", fillcolor=lightgreen];
    httpd_stop           [label="httpd_stop()\n[esp_http_server]", fillcolor=lightgreen];
    vTaskDelete          [label="vTaskDelete()\n[FreeRTOS]", fillcolor=lightgreen];
    cJSON_funcs          [label="cJSON_*()\n[cJSON]", fillcolor=lightgreen];
    esp_wifi_funcs       [label="esp_wifi_*()\n[esp_wifi]", fillcolor=lightgreen];

    /* ── Edges: app_main ── */
    app_main -> nvs_flash_init;
    app_main -> adc_sampler_init;
    app_main -> wifi_ap_init;
    app_main -> http_server_start;

    /* ── Edges: wifi_ap_init ── */
    wifi_ap_init -> esp_wifi_funcs;
    wifi_ap_init -> wifi_event_handler [label="registers CB", style=dashed];

    /* ── Edges: adc_sampler_init ── */
    adc_sampler_init -> xSemaphoreCreateMutex;
    adc_sampler_init -> adc_calibration_init [label="×2"];
    adc_sampler_init -> xTaskCreatePinnedToCore [label="→ adc_sampler_task\ncore=1"];

    /* ── Edges: adc_calibration_init ── */
    adc_calibration_init -> adc_cali_create [label="conditional\n#if CURVE_FITTING"];
    adc_cali_create [label="adc_cali_create_scheme_*()\n[esp_adc]", fillcolor=lightgreen];

    /* ── Edges: adc_sampler_task ── */
    adc_sampler_task -> adc_oneshot_read [label="×2 per sample"];
    adc_sampler_task -> esp_timer_get_time;
    adc_sampler_task -> esp_rom_delay_us [label="if period>10µs"];
    adc_sampler_task -> xSemaphoreTake [label="buffer swap"];
    adc_sampler_task -> xSemaphoreGive [label="buffer swap"];

    /* ── Edges: adc_sampler_get_frame ── */
    adc_sampler_get_frame -> xSemaphoreTake;
    adc_sampler_get_frame -> xSemaphoreGive;

    /* ── Edges: http_server_start ── */
    http_server_start -> httpd_start;
    http_server_start -> httpd_register_uri [label="×6 URIs"];
    http_server_start -> xTaskCreatePinnedToCore [label="→ ws_broadcast_task\ncore=0"];

    /* ── Edges: ws_broadcast_task ── */
    ws_broadcast_task -> adc_sampler_get_frame;
    ws_broadcast_task -> pack_frame;
    ws_broadcast_task -> httpd_ws_send_async [label="×N clients"];

    /* ── Edges: HTTP handlers ── */
    api_info_handler -> adc_sampler_get_rate;
    api_info_handler -> cJSON_funcs;
    api_config_handler -> adc_sampler_set_rate;
    api_config_handler -> cJSON_funcs;
    ws_handler -> adc_sampler_set_rate [label="via JSON cmd"];
    ws_handler -> cJSON_funcs;

    /* ── Edges: http_server_stop ── */
    http_server_stop -> httpd_stop;
    http_server_stop -> vTaskDelete;

    /* ── Subgraphs for layout ── */
    subgraph cluster_main {
        label = "main.c";
        style = dashed;
        color = gray;
        app_main;
    }

    subgraph cluster_wifi {
        label = "wifi_ap.c";
        style = dashed;
        color = gray;
        wifi_ap_init;
        wifi_event_handler;
    }

    subgraph cluster_adc {
        label = "adc_sampler.c";
        style = dashed;
        color = gray;
        adc_sampler_init;
        adc_sampler_get_frame;
        adc_sampler_set_rate;
        adc_sampler_get_rate;
        adc_calibration_init;
        adc_sampler_task;
    }

    subgraph cluster_http {
        label = "http_server.c";
        style = dashed;
        color = gray;
        http_server_start;
        http_server_stop;
        pack_frame;
        ws_broadcast_task;
        index_html_handler;
        app_js_handler;
        style_css_handler;
        api_info_handler;
        api_config_handler;
        ws_handler;
    }
}