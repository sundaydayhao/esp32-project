/**
 * ESP32-S3 Oscilloscope — Module / File Dependency Graph
 * Generated by static analysis (2026-03-19)
 *
 * Solid arrows  = #include dependency (compile-time)
 * Dashed arrows = runtime dependency (function call / data flow)
 */

digraph module_dependency {
    rankdir = TB;
    node [shape=box, style=filled, fontname="Consolas", fontsize=11];
    edge [fontsize=9];

    /* ── Firmware source files ── */
    main_c      [label="main/main.c\n(app_main)", fillcolor=lightcoral, style="filled,bold"];
    wifi_ap_c   [label="main/wifi_ap.c\n(WiFi AP)", fillcolor="#aed6f1"];
    wifi_ap_h   [label="main/wifi_ap.h", fillcolor="#d6eaf8", shape=note];
    adc_c       [label="main/adc_sampler.c\n(ADC + 双缓冲)", fillcolor="#a9dfbf"];
    adc_h       [label="main/adc_sampler.h\n(adc_frame_t)", fillcolor="#d5f5e3", shape=note];
    http_c      [label="main/http_server.c\n(HTTP + WebSocket)", fillcolor="#f9e79f"];
    http_h      [label="main/http_server.h", fillcolor="#fef9e7", shape=note];

    /* ── Web files (embedded) ── */
    index_html  [label="web/index.html\n(UI 结构)", fillcolor="#fadbd8", shape=component];
    app_js      [label="web/app.js\n(波形引擎)", fillcolor="#f1948a", shape=component];
    style_css   [label="web/style.css\n(深色主题)", fillcolor="#f5cba7", shape=component];

    /* ── ESP-IDF components ── */
    nvs_flash   [label="nvs_flash\n(NVS)", fillcolor=lightgray, shape=ellipse];
    esp_wifi    [label="esp_wifi\n(WiFi 驱动)", fillcolor=lightgray, shape=ellipse];
    esp_netif   [label="esp_netif\n(网络接口)", fillcolor=lightgray, shape=ellipse];
    esp_event   [label="esp_event\n(事件循环)", fillcolor=lightgray, shape=ellipse];
    esp_adc     [label="esp_adc\n(ADC 驱动)", fillcolor=lightgray, shape=ellipse];
    esp_httpd   [label="esp_http_server\n(HTTP/WS)", fillcolor=lightgray, shape=ellipse];
    cjson       [label="cJSON\n(JSON 库)", fillcolor=lightgray, shape=ellipse];
    freertos    [label="FreeRTOS\n(RTOS)", fillcolor=lightgray, shape=ellipse];
    lwip        [label="LwIP\n(TCP/IP)", fillcolor=lightgray, shape=ellipse];
    esp_timer   [label="esp_timer\n(高精度定时器)", fillcolor=lightgray, shape=ellipse];

    /* ── #include edges (solid) ── */
    main_c -> wifi_ap_h   [label="#include"];
    main_c -> http_h      [label="#include"];
    main_c -> adc_h       [label="#include"];
    wifi_ap_c -> wifi_ap_h [label="#include"];
    adc_c -> adc_h        [label="#include"];
    http_c -> http_h      [label="#include"];
    http_c -> adc_h       [label="#include"];

    /* ── ESP-IDF component edges (solid) ── */
    main_c -> nvs_flash   [label="nvs_flash_init"];
    wifi_ap_c -> esp_wifi [label="esp_wifi_*"];
    wifi_ap_c -> esp_netif [label="esp_netif_*"];
    wifi_ap_c -> esp_event [label="esp_event_*"];
    wifi_ap_c -> lwip     [label="lwip/err.h"];
    adc_c -> esp_adc      [label="adc_oneshot_*\nadc_cali_*"];
    adc_c -> freertos     [label="task, semphr"];
    adc_c -> esp_timer    [label="esp_timer_get_time"];
    http_c -> esp_httpd   [label="httpd_*"];
    http_c -> freertos    [label="task, queue"];
    http_c -> cjson       [label="cJSON_*"];
    http_c -> esp_timer   [label="esp_timer_get_time"];

    /* ── Embedded web files (dashed) ── */
    http_c -> index_html  [label="EMBED_FILES\n_binary_*", style=dashed, color=orange];
    http_c -> app_js      [label="EMBED_FILES\n_binary_*", style=dashed, color=orange];
    http_c -> style_css   [label="EMBED_FILES\n_binary_*", style=dashed, color=orange];

    /* ── Runtime data flow (dashed) ── */
    adc_c -> http_c       [label="adc_sampler_get_frame()\n[runtime data]", style=dashed, color=blue];

    /* ── Browser loads ── */
    index_html -> app_js  [label="<script src>", style=dashed, color=purple];
    index_html -> style_css [label="<link rel>", style=dashed, color=purple];

    /* ── Layout hints ── */
    { rank=same; main_c; }
    { rank=same; wifi_ap_c; adc_c; http_c; }
    { rank=same; wifi_ap_h; adc_h; http_h; }
    { rank=same; index_html; app_js; style_css; }
}